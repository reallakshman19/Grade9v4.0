{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "physics_claim": {
      "type": "string",
      "minLength": 1
    },
    "law_or_model": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validity_domain": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sign_convention": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "review_approval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "author_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "created_at",
    "physics_claim",
    "law_or_model",
    "assumptions",
    "validity_domain",
    "exceptions",
    "sign_convention",
    "source_ids",
    "review_approval_ids"
  ]
}
